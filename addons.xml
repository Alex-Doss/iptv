<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
<addon id="plugin.video.uaiptv" name="Для Бати" version="1.1.0" provider-name="Alex-Doss">
    <requires>
        <import addon="xbmc.python" version="2.25.0"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="default.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="ru">Лёгкий IPTV и сайты для старого TV box.</summary>
        <description lang="ru">Крупное меню, украинские и европейские каналы, избранное, сохранённые сайты, хвост логов и раздел версии.</description>
        <platform>all</platform>
        <language>ru</language>
        <license>MIT</license>
        <source>https://github.com/Alex-Doss/iptv</source>
        <assets>
            <icon>icon.png</icon>
            <fanart>fanart.jpg</fanart>
        </assets>
    </extension>
</addon>
<addon id="repository.alexdoss.iptv" name="Alex Doss IPTV Repository" version="1.0.0" provider-name="Alex-Doss">
    <extension point="xbmc.addon.repository" name="Alex Doss IPTV Repository">
        <info compressed="false">https://raw.githubusercontent.com/Alex-Doss/iptv/main/repository/addons.xml</info>
        <checksum>https://raw.githubusercontent.com/Alex-Doss/iptv/main/repository/addons.xml.md5</checksum>
        <datadir zip="true">https://raw.githubusercontent.com/Alex-Doss/iptv/main/repository/zips</datadir>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="ru">Репозиторий для обновления «Для Бати».</summary>
        <description lang="ru">Ставит и обновляет плагин «Для Бати» из GitHub-репозитория.</description>
        <platform>all</platform>
        <language>ru</language>
        <assets>
            <icon>icon.png</icon>
            <fanart>fanart.jpg</fanart>
        </assets>
    </extension>
</addon>
</addons>
